# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real values.
# You place credentials here yourself; nothing in this project asks for them.
# ---------------------------------------------------------------------------

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Where this API is reachable. Used to build the OAuth redirect URI, which must
# match the redirect URL registered in your Dhan developer console exactly.
APP_BASE_URL=http://localhost:3000

# Exact origin of the dashboard. Used for the CORS allowlist and as the
# postMessage target when the login popup hands back a session.
FRONTEND_ORIGIN=http://localhost:5273

# --- Dhan -------------------------------------------------------------------
# Your own API key and secret. Every Dhan account can generate these; it is
# not a partner programme. At web.dhan.co: My Profile -> Access DhanHQ APIs ->
# toggle to "API key" -> enter an app name and set the Redirect URL to
# http://localhost:3000/auth/dhan/callback exactly. Valid for 12 months.
#
# These are app identity, NOT an access token: you log in on Dhan's own page
# (QR scan, PIN or OTP — whichever you prefer) and this server exchanges the
# result for a 24-hour token that it encrypts immediately.
DHAN_API_KEY=
DHAN_API_SECRET=
# Your Dhan client id, needed to start a login.
DHAN_CLIENT_ID=

DHAN_API_BASE=https://api.dhan.co/v2
DHAN_AUTH_BASE=https://auth.dhan.co
DHAN_INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv

# --- OpenAI (optional) ------------------------------------------------------
# When absent, the AI analyst step is skipped and the response says so.
# It is never replaced with invented reasoning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Security ---------------------------------------------------------------
# Encrypts Dhan access tokens at rest. At least 32 characters, unique to you.
# The server refuses to boot in production while this is the default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_SECRET=dev-only-insecure-secret-change-me-32c

# Encrypted session file. Gitignored. Delete it to force a fresh login.
SESSION_STORE_PATH=.sessions.json
